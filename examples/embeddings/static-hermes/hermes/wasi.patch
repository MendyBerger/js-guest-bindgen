  */
 
-#ifdef __EMSCRIPTEN__
+#if defined(__EMSCRIPTEN__) || defined(__wasi__)
 
 #include "hermes/Support/ErrorHandling.h"
 #include "hermes/Support/OSCompat.h"
@@ -13,7 +13,12 @@
 #include <cassert>
 #include <vector>
 
+#ifdef __EMSCRIPTEN__
 #include <emscripten/stack.h>
+#else
+// stack bounds, defined by wasm-ld
+extern "C" char __stack_low, __stack_high;
+#endif
 #include <signal.h>
 #include <sys/mman.h>
 #include <sys/resource.h>
@@ -219,8 +224,13 @@
 namespace detail {
 
 std::pair<const void *, size_t> thread_stack_bounds_impl() {
+#ifdef __EMSCRIPTEN__
   uintptr_t high = emscripten_stack_get_base();
   uintptr_t low = emscripten_stack_get_end();
+#else
+  uintptr_t high = (uintptr_t)&__stack_high;
+  uintptr_t low = (uintptr_t)&__stack_low;
+#endif
   size_t sz = high - low;
   return {(void *)high, sz};
 }
