package example:compound;

interface shapes {
  record point {
    x: s32,
    y: s32,
  }

  variant shape {
    circle(u32),
    rect(tuple<u32, u32>),
    empty,
  }

  enum color {
    red,
    green,
    blue,
  }

  flags style {
    bold,
    italic,
    underline,
  }

  enum error {
    not-found,
    invalid,
  }

  area: func(s: shape) -> u64;
  centroid: func(points: list<point>) -> option<point>;
  parse-color: func(name: string) -> result<color, error>;
  styles: func(s: style) -> list<string>;
  checksum: func(bytes: list<u8>) -> u32;
}

interface store {
  get: func(key: string) -> option<list<u8>>;
  set: func(key: string, value: list<u8>) -> result<_, string>;
}

world compound {
  import store;
  export shapes;
}
